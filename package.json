{
  "name": "production-planning",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @production/api\" \"npm run dev -w @production/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts"
  },
  "devDependencies": {
    "argon2": "^0.41.1",
    "concurrently": "^9.1.2",
    "embedded-postgres": "^16.14.0-beta.17",
    "prisma": "6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.12.0": true,
    "@prisma/engines@6.12.0": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true,
    "@embedded-postgres/windows-x64@16.14.0-beta.17": true
  },
  "dependencies": {
    "@prisma/client": "^6.12.0"
  }
}
